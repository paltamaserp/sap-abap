+FORM log_write USING ut_msg TYPE bal_t_msg
+               CHANGING cv_error TYPE abap_bool.
+  DATA: lr_log TYPE REF TO zcl_pr_log,
+        lr_error TYPE REF TO cx_root,
+        ls_message TYPE bal_s_msg,
+        lv_text TYPE string,
+        lv_dummy TYPE string.
+  cv_error = abap_false.
+  CHECK ut_msg IS NOT INITIAL.
+  "Business changes have already been committed or rolled back.
+  TRY.
+      CREATE OBJECT lr_log
+        EXPORTING iv_log_object = gc_log_object
+                  iv_log_subobject = gc_log_subobj.
+      LOOP AT ut_msg INTO ls_message.
+        MESSAGE ID ls_message-msgid TYPE ls_message-msgty
+          NUMBER ls_message-msgno
+          WITH ls_message-msgv1 ls_message-msgv2
+               ls_message-msgv3 ls_message-msgv4 INTO lv_dummy.
+        lr_log->add_system_message( ).
+      ENDLOOP.
+      lr_log->close( ).
+      COMMIT WORK.
+      lr_log->display( ).
+    CATCH cx_root INTO lr_error.
+      ROLLBACK WORK.
+      cv_error = abap_true.
+      lv_text = lr_error->get_text( ).
+      MESSAGE s000 WITH text-102 lv_text
+        DISPLAY LIKE 'E'.
+  ENDTRY.
+ENDFORM.
 
-* ⚠️ Feltételezés - a close( ) menti a naplót (BAL_DB_SAVE).
