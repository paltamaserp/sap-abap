# =============================================================================
# MINTA a Playwright OData tesztekhez -> masold at .env nevre es toltsd ki.
#   cp .env.example .env
# A valodi .env gitignore-olt (lasd .gitignore) — titok soha nem verziozodik.
#
# Ha a repo gyokereben mar van kitoltott .env, onnan is masolhatod az ertekeket.
# =============================================================================

# SAP host URL. FONTOS: a vegen legyen '/' (a szerviz-path ehhez fuzodik).
SAP_URL=https://<host>:<port>/

# Bejelentkezesi kliens (mandant).
SAP_CLIENT=100

# SAP felhasznalonev.
SAP_USERNAME=<sap-user>

# SAP jelszo. Csak a lokalis .env-be kerul, ide (mintaba) SOHA ne ird be.
SAP_PASSWORD=

# A tesztelt OData szerviz neve (pl. ZEPT_PT_ACCOUNT_SRV).
SAP_SERVICE=ZEPT_..._SRV

# Onaláirt tanusitvanynal 0-ra allitva atugorja a TLS ellenorzest.
# CSAK dev/qa rendszeren! Prod ellen soha.
SAP_TLS_VERIFY=1
